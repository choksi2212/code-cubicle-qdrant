# FieldEdge Sync API — local development environment template.
# Copy this file to `.env` and fill in real values for any service you
# want to talk to locally. Variables left at their defaults are fine
# for the happy-path smoke tests; the unit-test suite runs with Redis
# disabled (see tests/conftest.py) and Qdrant mocked.

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Qdrant (vector store) ──────────────────────────────────────────────────
# Local Qdrant (Docker):  http://localhost:6333
# Qdrant Cloud:           https://<cluster>.<region>.aws.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=field_edge_central

# ── JWT signing ─────────────────────────────────────────────────────────────
# Production MUST set JWT_SECRET explicitly (Render injects it from
# the dashboard secret store). Leave unset locally and the server
# auto-generates one to apps/sync-api/app/.jwt_secret on first boot.
# JWT_SECRET=

# Access tokens are short-lived (15 min). Refresh tokens live for 7 days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Redis (JWT revocation list + sync upload idempotency cache) ────────────
# Provisioned on the Redis Labs free tier (30 MB / 100 ops/sec / 30 conns).
# When REDIS_ENABLED=false the revocation list + idempotency cache are
# bypassed entirely — the app falls back to the v0 behaviour:
#   - old refresh tokens keep working after rotation
#   - duplicate uploads are re-processed (no `already_received` cache hit)
# See docs/12-REDIS.md for the rollout plan and the failure modes.
REDIS_URL=redis://default:b9FfN7glX71uiwykWW6WZqMjZg6NIhR2@redis-19164.c270.us-east-1-3.ec2.cloud.redislabs.com:19164
REDIS_ENABLED=true
