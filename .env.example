# ─────────────────────────────────────────────────────────────────────────────
# FieldEdge Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Qdrant Cloud (central cluster) ──────────────────────────────────────────
# Get these from https://cloud.qdrant.io after creating a free-tier cluster.
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# ── Sync API (this app's server) ─────────────────────────────────────────────
# Local dev:
SYNC_API_URL=http://localhost:8000
# Production (after Render deployment — see apps/sync-api/deploy-render.md):
# SYNC_API_URL=https://field-edge-sync-api.onrender.com

# ── enrichment (Mihir's track; required for full enrichment pipeline) ────────
# Get from https://enrichment.com/console
CLOUDINARY_API_KEY=your-enrichment-api-key

# ── Sync API server-only secrets (used when running `pnpm sync-api:dev`) ──────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-random-256-bit-base64
DATABASE_URL=sqlite:///./sync.db
LOG_LEVEL=INFO

# ── Optional tuning ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
EMBEDDING_MODEL_PATH=./apps/mobile/src/assets/models/clip-vit-b32-int8.onnx
SEED_DATASET_PATH=./apps/mobile/src/assets/seed/
